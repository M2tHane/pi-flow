{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pi-flow/notes.schema.json",
  "type": "object",
  "required": [
    "goal",
    "done",
    "todo",
    "current",
    "decisions",
    "pitfalls",
    "updated_at",
    "version"
  ],
  "properties": {
    "goal": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "maxItems": 60
    },
    "done": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "maxItems": 60
    },
    "todo": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "maxItems": 60
    },
    "current": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "maxItems": 60
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "maxItems": 60
    },
    "pitfalls": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "maxItems": 60
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false
}
