{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pi-flow/stage-review.schema.json",
  "type": "object",
  "required": [
    "stage",
    "status",
    "base_sha",
    "batches",
    "test_rounds",
    "version"
  ],
  "properties": {
    "stage": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "reviewing",
        "gating",
        "test_fixing",
        "needs_human",
        "done"
      ]
    },
    "base_sha": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "batches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "roles",
          "tasks",
          "status",
          "review_task",
          "reported",
          "issues",
          "fix_tasks",
          "confirm_task",
          "confirm",
          "refix_tasks"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "tasks": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^T-[0-9]{3,}$"
            }
          },
          "status": {
            "enum": [
              "reviewing",
              "fixing",
              "confirming",
              "refixing",
              "done"
            ]
          },
          "review_task": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^T-[0-9]{3,}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "reported": {
            "type": "boolean"
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "module",
                "location",
                "problem",
                "expected",
                "files"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^R-[0-9]+$"
                },
                "module": {
                  "type": "string",
                  "minLength": 1
                },
                "location": {
                  "type": "string",
                  "minLength": 1
                },
                "problem": {
                  "type": "string",
                  "minLength": 1
                },
                "expected": {
                  "type": "string",
                  "minLength": 1
                },
                "files": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                }
              },
              "additionalProperties": false
            }
          },
          "fix_base": {
            "type": "string"
          },
          "fix_tasks": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^T-[0-9]{3,}$"
            }
          },
          "confirm_task": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^T-[0-9]{3,}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "confirm": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "resolved"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^R-[0-9]+$"
                },
                "resolved": {
                  "type": "boolean"
                },
                "note": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "refix_tasks": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^T-[0-9]{3,}$"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "test_rounds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "command",
          "tasks",
          "at"
        ],
        "properties": {
          "command": {
            "type": "string"
          },
          "tasks": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^T-[0-9]{3,}$"
            }
          },
          "at": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "reason": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false
}
