{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pi-flow/workflow.schema.json",
  "type": "object",
  "required": [
    "version",
    "project",
    "main_branch",
    "commands",
    "limits",
    "models",
    "modes",
    "scopes",
    "tool_groups",
    "roles"
  ],
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "main_branch": {
      "type": "string",
      "minLength": 1
    },
    "commands": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "limits": {
      "type": "object",
      "required": [
        "max_parallel",
        "max_attempts",
        "lease_minutes",
        "max_violations_per_run",
        "max_task_files",
        "fix_max_files"
      ],
      "properties": {
        "max_parallel": {
          "type": "integer",
          "minimum": 1
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "lease_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "max_violations_per_run": {
          "type": "integer",
          "minimum": 1
        },
        "max_task_files": {
          "type": "integer",
          "minimum": 1
        },
        "fix_max_files": {
          "type": "integer",
          "minimum": 1
        },
        "session_retention_days": {
          "type": "integer",
          "minimum": 1
        },
        "continue_session": {
          "type": "boolean"
        },
        "bash_timeout_s": {
          "type": "integer",
          "minimum": 1
        },
        "auto_dispatch": {
          "type": "boolean"
        },
        "merge_batch": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "models": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "modes": {
      "type": "object",
      "properties": {
        "build": {
          "type": "object",
          "required": [
            "stages"
          ],
          "properties": {
            "stages": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "name",
                  "gate"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "phase": {
                    "enum": [
                      "requirements",
                      "prototype",
                      "planning",
                      "execution"
                    ]
                  },
                  "gate": {
                    "type": "object",
                    "properties": {
                      "human": {
                        "type": "boolean"
                      },
                      "auto": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "all_tasks_done": {
                        "type": "boolean"
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "additionalProperties": false
        },
        "feature": {
          "type": "object",
          "required": [
            "stages"
          ],
          "properties": {
            "stages": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "name",
                  "gate"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "phase": {
                    "enum": [
                      "requirements",
                      "prototype",
                      "planning",
                      "execution"
                    ]
                  },
                  "gate": {
                    "type": "object",
                    "properties": {
                      "human": {
                        "type": "boolean"
                      },
                      "auto": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "all_tasks_done": {
                        "type": "boolean"
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "scopes": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "type": "object",
          "required": [
            "writes"
          ],
          "properties": {
            "rules": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "writes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      }
    },
    "tool_groups": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "roles": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "type": "object",
          "required": [
            "model",
            "tools"
          ],
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1
            },
            "thinking": {
              "enum": [
                "off",
                "minimal",
                "low",
                "medium",
                "high",
                "xhigh",
                "max"
              ]
            },
            "scopes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "tools": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "read_paths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "writes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "env": {
              "type": "object",
              "patternProperties": {
                "^.*$": {
                  "type": "string"
                }
              }
            },
            "escalate_model": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      }
    },
    "review": {
      "type": "object",
      "properties": {
        "per_task": {
          "type": "boolean"
        },
        "stage_end": {
          "type": "boolean"
        },
        "test_stages": {
          "anyOf": [
            {
              "type": "string",
              "const": "skip"
            },
            {
              "type": "string",
              "const": "light"
            },
            {
              "type": "string",
              "const": "strong"
            }
          ]
        },
        "max_parallel": {
          "type": "integer",
          "minimum": 1
        },
        "low_risk": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "mode": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "cheap"
                },
                {
                  "type": "string",
                  "const": "skip"
                }
              ]
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "max_files": {
              "type": "integer",
              "minimum": 1
            },
            "max_lines": {
              "type": "integer",
              "minimum": 1
            },
            "paths": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "exclude": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        },
        "high_risk": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "max_lines": {
              "type": "integer",
              "minimum": 1
            },
            "paths": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        },
        "verify_first": {
          "type": "boolean"
        },
        "max_rounds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "escalation": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "after_failures": {
          "type": "integer",
          "minimum": 1
        },
        "critical_fanout": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "testing": {
      "type": "object",
      "properties": {
        "leading_tests": {
          "type": "boolean"
        },
        "adjust_tests": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "knowledge": {
      "type": "object",
      "properties": {
        "auto_candidates": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "properties": {
        "compact_at": {
          "type": "number",
          "minimum": 0.3,
          "maximum": 0.95
        }
      },
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "properties": {
        "tokens": {
          "type": "integer",
          "minimum": 1
        },
        "cost": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "warn_ratio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
