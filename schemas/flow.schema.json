{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pi-flow/flow.schema.json",
  "type": "object",
  "required": [
    "id",
    "mode",
    "title",
    "stages",
    "stage",
    "stage_status",
    "integration_branch",
    "base_sha",
    "approvals",
    "created_at",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[BFX]-[0-9]{3,}$"
    },
    "mode": {
      "anyOf": [
        {
          "type": "string",
          "const": "build"
        },
        {
          "type": "string",
          "const": "feature"
        },
        {
          "type": "string",
          "const": "fix"
        }
      ]
    },
    "title": {
      "type": "string"
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "stage": {
      "type": "string",
      "minLength": 1
    },
    "stage_status": {
      "enum": [
        "active",
        "awaiting_gate",
        "awaiting_human",
        "done",
        "aborted"
      ]
    },
    "integration_branch": {
      "type": "string",
      "minLength": 1
    },
    "base_sha": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "approvals": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "type": "object",
          "required": [
            "by",
            "at"
          ],
          "properties": {
            "by": {
              "type": "string",
              "const": "human"
            },
            "at": {
              "type": "string",
              "minLength": 1
            },
            "note": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "budget": {
      "type": "object",
      "properties": {
        "tokens": {
          "type": "integer",
          "minimum": 1
        },
        "cost": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    },
    "sync": {
      "type": "object",
      "required": [
        "stage",
        "status",
        "main_sha",
        "at"
      ],
      "properties": {
        "stage": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "anyOf": [
            {
              "type": "string",
              "const": "ok"
            },
            {
              "type": "string",
              "const": "fixing"
            },
            {
              "type": "string",
              "const": "conflict"
            }
          ]
        },
        "main_sha": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "string",
          "minLength": 1
        },
        "task": {
          "type": "string",
          "pattern": "^T-[0-9]{3,}$"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "version": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false
}
