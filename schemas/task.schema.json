{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pi-flow/task.schema.json",
  "type": "object",
  "required": [
    "id",
    "stage",
    "kind",
    "title",
    "role",
    "scopes",
    "depends_on",
    "inputs",
    "writes",
    "acceptance",
    "verify",
    "status",
    "attempts",
    "violations",
    "lease_expirations",
    "lease",
    "impl_run",
    "branch",
    "worktree",
    "base_sha",
    "blocked_reason",
    "last_failure",
    "created_by",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^T-[0-9]{3,}$"
    },
    "stage": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "test",
        "impl",
        "doc",
        "infra",
        "integration",
        "review-fix",
        "merge-fix",
        "analysis"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "task",
          "type"
        ],
        "properties": {
          "task": {
            "type": "string",
            "pattern": "^T-[0-9]{3,}$"
          },
          "type": {
            "anyOf": [
              {
                "type": "string",
                "const": "hard"
              },
              {
                "type": "string",
                "const": "soft"
              }
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "writes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verify": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "pending",
        "ready",
        "in_progress",
        "review",
        "verifying",
        "queued_merge",
        "merging",
        "done",
        "blocked",
        "cancelled"
      ]
    },
    "attempts": {
      "type": "integer",
      "minimum": 0
    },
    "violations": {
      "type": "integer",
      "minimum": 0
    },
    "lease_expirations": {
      "type": "integer",
      "minimum": 0
    },
    "interruptions": {
      "type": "integer",
      "minimum": 0
    },
    "lease": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "run_id",
            "role",
            "token_hash",
            "acquired_at",
            "expires_at"
          ],
          "properties": {
            "run_id": {
              "type": "string",
              "minLength": 1
            },
            "role": {
              "type": "string",
              "minLength": 1
            },
            "token_hash": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64
            },
            "acquired_at": {
              "type": "string",
              "minLength": 1
            },
            "expires_at": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "impl_run": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "branch": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "worktree": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "base_sha": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "blocked_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "blocked_from": {
      "enum": [
        "pending",
        "ready",
        "in_progress",
        "review",
        "verifying",
        "queued_merge",
        "merging",
        "done",
        "blocked",
        "cancelled"
      ]
    },
    "last_failure": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "replan": {
      "type": "string",
      "minLength": 1
    },
    "contract_change": {
      "type": "boolean"
    },
    "findings": {
      "type": "object",
      "required": [
        "location",
        "root_cause",
        "impact_files",
        "suggested_role",
        "contract_change",
        "estimated_files"
      ],
      "properties": {
        "location": {
          "type": "string"
        },
        "root_cause": {
          "type": "string"
        },
        "impact_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "suggested_role": {
          "type": "string"
        },
        "contract_change": {
          "type": "boolean"
        },
        "estimated_files": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "merge_fix_for": {
      "type": "string",
      "pattern": "^T-[0-9]{3,}$"
    },
    "conflict_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sync_main": {
      "type": "string",
      "minLength": 1
    },
    "stage_review": {
      "anyOf": [
        {
          "type": "string",
          "const": "review"
        },
        {
          "type": "string",
          "const": "confirm"
        }
      ]
    },
    "review_issues": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^R-[0-9]+$"
      }
    },
    "fork_from_task": {
      "type": "string",
      "pattern": "^T-[0-9]{3,}$"
    },
    "test_adjustments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_by": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false
}
