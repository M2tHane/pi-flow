ry></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#059669;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#DC2626;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="c3" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="没修好：接着原会话（两轮上限）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#DC2626;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="c5" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="流程进行中" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#334155;strokeColor=none;fontColor=#FFFFFF;fontSize=14;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="1500" height="40" as="geometry"/></mxCell><mxCell id="c14" value='&lt;b&gt;/flow-add "追加的需求"&lt;/b&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="300" height="60" as="geometry"/></mxCell><mxCell id="c15" value="只有一个模块在做：送进它的会话（steer），写进它的 notes 目标&lt;br&gt;多个模块在做：交给 architect 判断归属（--task 可直接指定）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;spacing=8;fontFamily=Helvetica;align=left;" vertex="1" parent="1"><mxGeometry x="400" y="460" width="560" height="80" as="geometry"/></mxCell><mxCell id="c16" value='&lt;b&gt;/flow replan "要改什么"&lt;/b&gt;（或直接告诉主 agent）' style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="300" height="70" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;architect&lt;/b&gt; 起草计划修订&lt;br&gt;新增模块、调整或取消未开始的模块" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="400" y="580" width="340" height="70" as="geometry"/></mxCell><mxCell id="c18" value="你批准&lt;br&gt;修订" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;fontSize=12;fontColor=#0F172A;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="800" y="565" width="160" height="100" as="geometry"/></mxCell><mxCell id="c19" value="生效：新任务进入 DAG；&lt;br&gt;被点名的任务在批准前暂停派发" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1020" y="580" width="340" height="70" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;主分支有新提交&lt;/b&gt;（你自己的改动、fix 合入）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F0F9FF;strokeColor=#0284C7;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="300" height="70" as="geometry"/></mxCell><mxCell id="c21" value="每个阶段开始时同步进集成分支&lt;br&gt;冲突在某模块可写范围内：生成 merge-fix&lt;br&gt;涉及受保护路径：暂停，你处理后 /flow sync" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;spacing=8;fon