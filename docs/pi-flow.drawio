FFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#94A3B8;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#059669;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="c10" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="批准" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#EA580C;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="打回" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#DC2626;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="c12" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#DC2626;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="c14" target="c3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="20" y="705"/><mxPoint x="20" y="100"/><mxPoint x="460" y="100"/></Array></mxGeometry></mxCell><mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#EA580C;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c15" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#334155;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="200" height="24" as="geometry"/></mxCell><mxCell id="c32" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="790" width="30" height="20" as="geometry"/></mxCell><mxCell id="c33" value="你（人工操作、审批）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="80" y="788" width="260" height="24" as="geometry"/></mxCell><mxCell id="c34" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EEF2FF;strokeColor=#4F46E5;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="30" height="20" as="geometry"/></mxCell><mxCell id="c35" value="主 agent（主会话）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="80" y="818" width="260" height="24" as="geometry"/></mxCell><mxCell id="c36" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="850" width="30" height="20" as="geometry"/></mxCell><mxCell id="c37" value="subagent（独立 pi 进程 + worktree）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="80" y="848" width="260" height="24" as="geometry"/></mxCell><mxCell id="c38" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="880" width="30" height="20" as="geometry"/></mxCell><mxCell id="c39" value="程序（引擎，确定性步骤）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="80" y="878" width="260" height="24" as="geometry"/></mxCell><mxCell id="c40" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="910" width="30" height="20" as="geometry"/></mxCell><mxCell id="c41" value="失败 / 需要你处理" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="80" y="908" width="260" height="24" as="geometry"/></mxCell><mxCell id="c42" value="产出文件" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;fontSize=12;fontColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="940" width="90" height="26" as="geometry"/></mxCell><mxCell id="c43" value="闸门" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;fontSize=12;fontColor=#0F172A;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="150" y="936" width="70" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page4" name="4 实施：模块的生命周期"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1220" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value='&lt;b style="font-size:26px"&gt;实施阶段：一个模块从开工到合入&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:14px;color:#64748B"&gt;模块之间按依赖并行；每个模块合并后先独立验收，依赖它的模块等验收通过才开工&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#0F172A;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1620" height="70" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;你批准规划&lt;/b&gt;&lt;br&gt;程序按模块清单生成模块任务" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="260" height="70" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;依赖都已验收？&lt;/b&gt;&lt;br&gt;就绪的模块自动派发&lt;br&gt;（并发上限 max_parallel）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="230" width="260" height="80" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;implementer&lt;/b&gt; 在自己的 worktree 开发&lt;br&gt;• 输入：需求、modules.md、术语表、接口文档；界面模块还有原型页面与 DESIGN.md&lt;br&gt;• 先写测试再实现（tdd）&lt;br&gt;• 每完成一部分就本地 git commit、更新 notes&lt;br&gt;• 需要别的模块刚合入的代码：flow_sync" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;spacing=8;fontFamily=Helvetica;align=left;" vertex="1" parent="1"><mxGeometry x="380" y="210" width="360" height="170" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;flow_submit&lt;/b&gt;&lt;br&gt;只检查改动都在可写范围内" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="380" y="420" width="360" height="60" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;合并队列&lt;/b&gt;（串行，最多 3 个一批）&lt;br&gt;squash → rebase 到集成分支最新&lt;br&gt;→ 全量 typecheck · lint · test · merge_check" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="380" y="520" width="360" height="90" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;全量测试失败&lt;/b&gt;&lt;br&gt;带着日志退回同一会话修" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="800" y="535" width="250" height="60" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;快进集成分支&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F0F9FF;strokeColor=#0284C7;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="380" y="650" width="360" height="50" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b&gt;acceptor 独立验收&lt;/b&gt;&lt;br&gt;在集成分支上构建、启动、实际调用&lt;br&gt;逐条给"通过 / 未通过 + 证据"（flow_accept）' style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="380" y="740" width="360" height="90" as="geometry"/></mxCell><mxCell id="c10" value="全部&lt;br&gt;通过？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;fontSize=12;fontColor=#0F172A;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="470" y="870" width="180" height="100" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;模块已验收&lt;/b&gt;&lt;br&gt;依赖它的模块开工" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="890" width="260" height="60" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;修复任务&lt;/b&gt;&lt;br&gt;接着 implementer 原来的会话（pi --fork）&lt;br&gt;只修没通过的条目" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="800" y="870" width="300" height="80" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;acceptor 复查&lt;/b&gt;&lt;br&gt;只看没通过的条目，不能提新问题" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="800" y="990" width="300" height="70" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;两轮仍不过 → 需要你处理&lt;/b&gt;&lt;br&gt;/flow accept 人工放行，或 /flow replan" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="800" y="1100" width="300" height="70" as="geometry"/></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#059669;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="派发" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#059669;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#7C3AED;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#059669;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="失败" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#DC2626;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#DC2626;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0.5;exitY=0;entryX=1;entryY=0.5;" edge="1" parent="1" source="c7" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="通过" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#059669;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#059669;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#059669;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#059669;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#DC2626;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="c10" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="合并后" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#7C3AED;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="通过" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#059669;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="c13" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="仍不过" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#DC2626;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="解锁下游" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#059669;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c11" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c60" value="&lt;b&gt;时间预算用完&lt;/b&gt;（M 号 30 分钟，S 减半、L 加倍）&lt;br&gt;先提醒收尾，宽限 5 分钟后结束；不算失败" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;spacing=8;fontFamily=Helvetica;align=left;" vertex="1" parent="1"><mxGeometry x="800" y="210" width="300" height="70" as="geometry"/></mxCell><mxCell id="c61" value="&lt;b&gt;主 agent 复核&lt;/b&gt;：看改动、handoff、最后的回复&lt;br&gt;• continue：接着原会话再做&lt;br&gt;• restart：不带旧对话换个思路&lt;br&gt;• block：交给你（超时超过 2 次也是）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EEF2FF;strokeColor=#4F46E5;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;spacing=8;fontFamily=Helvetica;align=left;" vertex="1" parent="1"><mxGeometry x="800" y="300" width="300" height="100" as="geometry"/></mxCell><mxCell id="c62" value="超时" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#DC2626;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.25;entryX=0;entryY=0.5;" edge="1" parent="1" source="c4" target="c60"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c63" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#4F46E5;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="c60" target="c61"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c64" value="continue / restart" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#4F46E5;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;exitX=0;exitY=0.75;entryX=1;entryY=0.75;" edge="1" parent="1" source="c61" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c65" value="&lt;b&gt;需要你打开查看&lt;/b&gt;：规划时写的 manual_checks 与验收者标出的条目，列在“需要你处理”里（agent 不打开桌面应用与浏览器）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;spacing=8;fontFamily=Helvetica;align=left;" vertex="1" parent="1"><mxGeometry x="60" y="990" width="260" height="90" as="geometry"/></mxCell><mxCell id="c66" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#EA580C;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;" edge="1" parent="1" source="c11" target="c65"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="所有模块验收通过后" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#059669;strokeColor=none;fontColor=#FFFFFF;fontSize=14;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1160" y="120" width="480" height="40" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;最终代码审查（可选，review.final）&lt;/b&gt;&lt;br&gt;reviewer 审查整个流程的改动 → docs/review/final.md&lt;br&gt;必须改：自动交给负责的模块修一轮&lt;br&gt;建议：你挑 /flow review fix R-3 或 /flow review done" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;spacing=8;fontFamily=Helvetica;align=left;" vertex="1" parent="1"><mxGeometry x="1160" y="180" width="480" height="120" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;阶段闸门：全量测试&lt;/b&gt;&lt;br&gt;失败时按日志找到负责的模块修，最多两轮" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1160" y="340" width="480" height="70" as="geometry"/></mxCell><mxCell id="c33" value="你批准&lt;br&gt;/flow-approve --yes" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;fontSize=12;fontColor=#0F172A;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1300" y="450" width="200" height="110" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;集成分支合入主分支&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F0F9FF;strokeColor=#0284C7;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1160" y="600" width="480" height="50" as="geometry"/></mxCell><mxCell id="c35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#059669;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="c31" target="c32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#059669;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="c32" target="c33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#EA580C;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="c33" target="c34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c38" value="&lt;b&gt;并行示例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#334155;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1160" y="700" width="300" height="24" as="geometry"/></mxCell><mxCell id="c39" value="M-1 底座" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1160" y="740" width="140" height="50" as="geometry"/></mxCell><mxCell id="c40" value="M-2 待办" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1360" y="710" width="140" height="50" as="geometry"/></mxCell><mxCell id="c41" value="M-3 标签" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1360" y="780" width="140" height="50" as="geometry"/></mxCell><mxCell id="c42" value="验收后" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#059669;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="c39" target="c40"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#059669;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="c39" target="c41"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c44" value="M-2、M-3 互不依赖，同时开发；&lt;br&gt;登记的公共文件（路由、菜单）可以都改，冲突交给 merge-fix" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;fontSize=12;fontColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1160" y="850" width="480" height="60" as="geometry"/></mxCell><mxCell id="c45" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#334155;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1160" y="950" width="200" height="24" as="geometry"/></mxCell><mxCell id="c46" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1160" y="980" width="30" height="20" as="geometry"/></mxCell><mxCell id="c47" value="你（人工操作、审批）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1200" y="978" width="260" height="24" as="geometry"/></mxCell><mxCell id="c48" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EEF2FF;strokeColor=#4F46E5;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1160" y="1010" width="30" height="20" as="geometry"/></mxCell><mxCell id="c49" value="主 agent（主会话）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1200" y="1008" width="260" height="24" as="geometry"/></mxCell><mxCell id="c50" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1160" y="1040" width="30" height="20" as="geometry"/></mxCell><mxCell id="c51" value="subagent（独立 pi 进程 + worktree）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1200" y="1038" width="260" height="24" as="geometry"/></mxCell><mxCell id="c52" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1160" y="1070" width="30" height="20" as="geometry"/></mxCell><mxCell id="c53" value="程序（引擎，确定性步骤）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1200" y="1068" width="260" height="24" as="geometry"/></mxCell><mxCell id="c54" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1160" y="1100" width="30" height="20" as="geometry"/></mxCell><mxCell id="c55" value="失败 / 需要你处理" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1200" y="1098" width="260" height="24" as="geometry"/></mxCell><mxCell id="c56" value="产出文件" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;fontSize=12;fontColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1160" y="1130" width="90" height="26" as="geometry"/></mxCell><mxCell id="c57" value="闸门" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;fontSize=12;fontColor=#0F172A;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1270" y="1126" width="70" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page5" name="5 架构与安全"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value='&lt;b style="font-size:26px"&gt;架构：谁在哪里运行、状态怎么保存&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:14px;color:#64748B"&gt;只有 src/pi-adapter/ 调用 Pi；业务逻辑在 src/core/，不依赖 Pi&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#0F172A;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1520" height="70" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;你&lt;/b&gt;&lt;br&gt;终端里的 pi" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="200" height="70" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;主会话 pi + pi-flow 扩展&lt;/b&gt;&lt;br&gt;• 调度模式：切到 orchestrator 的模型和工具&lt;br&gt;• 每轮注入"当前状态与唯一允许的下一步"&lt;br&gt;• 主会话的 guard：不能写文件&lt;br&gt;• 斜杠命令 /flow-*' style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EEF2FF;strokeColor=#4F46E5;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;spacing=8;fontFamily=Helvetica;align=left;" vertex="1" parent="1"><mxGeometry x="340" y="110" width="380" height="140" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;引擎（同一进程内）&lt;/b&gt;&lt;br&gt;• 派发与并发、租约与心跳&lt;br&gt;• 合并队列、全量测试&lt;br&gt;• 验收、修复、闸门的推进（pump）&lt;br&gt;• 额度用完 / 限流时暂停模型" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;spacing=8;fontFamily=Helvetica;align=left;" vertex="1" parent="1"><mxGeometry x="340" y="300" width="380" height="150" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;StateStore · .flow/&lt;/b&gt;&lt;br&gt;flow.json · tasks/ · runs/ · notes/ · acceptance/&lt;br&gt;事件日志带哈希链&lt;br&gt;每次变化提交到 refs/pi-flow/state" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;spacing=8;fontFamily=Helvetica;align=left;" vertex="1" parent="1"><mxGeometry x="800" y="300" width="360" height="150" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;subagent 进程&lt;/b&gt;（每个任务一个）&lt;br&gt;pi --mode rpc · --no-extensions&lt;br&gt;只启用本角色的工具；插件按需 -e 加载&lt;br&gt;&lt;b&gt;guard 扩展最后加载&lt;/b&gt;：可写范围、受保护路径、bash 白名单、敏感文件" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;spacing=8;fontFamily=Helvetica;align=left;" vertex="1" parent="1"><mxGeometry x="340" y="510" width="380" height="140" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;git worktree&lt;/b&gt;（项目目录之外）&lt;br&gt;&amp;lt;项目&amp;gt;.worktrees/&amp;lt;流程&amp;gt;/&amp;lt;任务&amp;gt;&lt;br&gt;任务分支 → squash 合入集成分支" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F0F9FF;strokeColor=#0284C7;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;spacing=8;fontFamily=Helvetica;align=left;" vertex="1" parent="1"><mxGeometry x="800" y="510" width="360" height="140" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;分支&lt;/b&gt;&lt;br&gt;main ← flow/&amp;lt;流程&amp;gt;/integration ← 任务分支&lt;br&gt;阶段开始时把 main 同步进集成分支" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F0F9FF;strokeColor=#0284C7;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;spacing=8;fontFamily=Helvetica;align=left;" vertex="1" parent="1"><mxGeometry x="1220" y="510" width="340" height="140" as="geometry"/></mxCell><mxCell id="c9" value="对话、命令" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#EA580C;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#059669;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="唯一写入者" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#059669;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="启动、RPC（steer）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#059669;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="读写代码" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#059669;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="合并队列" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#059669;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="flow_* 工具（带 token）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#7C3AED;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;exitX=0.82;exitY=0;entryX=0.08;entryY=1;" edge="1" parent="1" source="c6" target="c5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="652" y="480"/><mxPoint x="829" y="480"/></Array></mxGeometry></mxCell><mxCell id="c16" value="&lt;b&gt;恢复&lt;/b&gt;：进程被杀后 /flow-resume。只依赖 .flow/ 与 git：租约过期的任务回到原 worktree，接着原会话继续（本地提交都在）；合并进行中的回滚到队首重来。" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;fontSize=12;fontColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="700" width="520" height="90" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;越权&lt;/b&gt;：guard 拦下并计违规，达到上限结束本次运行；主工作区在主会话一轮里出现未经派发的改动，记为越权并提醒你。" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;fontSize=12;fontColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="620" y="700" width="520" height="90" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;模型&lt;/b&gt;：每个角色的模型与思考级别在 /flow-config 设置（~/.pi/agent/pi-flow.json），优先于 workflow.yaml 的档位；同一任务失败多次后换升级模型。" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;fontSize=12;fontColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1180" y="700" width="380" height="90" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#334155;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="820" width="200" height="24" as="geometry"/></mxCell><mxCell id="c20" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="850" width="30" height="20" as="geometry"/></mxCell><mxCell id="c21" value="你（人工操作、审批）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="100" y="848" width="260" height="24" as="geometry"/></mxCell><mxCell id="c22" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EEF2FF;strokeColor=#4F46E5;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="880" width="30" height="20" as="geometry"/></mxCell><mxCell id="c23" value="主 agent（主会话）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="100" y="878" width="260" height="24" as="geometry"/></mxCell><mxCell id="c24" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="910" width="30" height="20" as="geometry"/></mxCell><mxCell id="c25" value="subagent（独立 pi 进程 + worktree）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="100" y="908" width="260" height="24" as="geometry"/></mxCell><mxCell id="c26" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="940" width="30" height="20" as="geometry"/></mxCell><mxCell id="c27" value="程序（引擎，确定性步骤）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="100" y="938" width="260" height="24" as="geometry"/></mxCell><mxCell id="c28" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="970" width="30" height="20" as="geometry"/></mxCell><mxCell id="c29" value="失败 / 需要你处理" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="100" y="968" width="260" height="24" as="geometry"/></mxCell><mxCell id="c30" value="产出文件" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;fontSize=12;fontColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="1000" width="90" height="26" as="geometry"/></mxCell><mxCell id="c31" value="闸门" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;fontSize=12;fontColor=#0F172A;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="170" y="996" width="70" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page6" name="6 修复与中途变更"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value='&lt;b style="font-size:26px"&gt;修复与中途变更&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:14px;color:#64748B"&gt;修 bug 不建 DAG；流程进行中可以追加需求、修订计划，主分支的改动会同步进来&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#0F172A;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1520" height="70" as="geometry"/></mxCell><mxCell id="c2" value='/flow-fix "问题描述"' style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DC2626;strokeColor=none;fontColor=#FFFFFF;fontSize=14;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="1500" height="40" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;implementer&lt;/b&gt;&lt;br&gt;定位、修复、加回归测试" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="260" height="80" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;合并&lt;/b&gt;&lt;br